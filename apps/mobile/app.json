{
  "expo": {
    "name": "MeetRiders Mobile",
    "slug": "meet-riders-mobile",
    "version": "0.1.6",
    "orientation": "portrait",
    "scheme": "meetriders",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "expo-web-browser"
    ],
    "splash": {
      "backgroundColor": "#0f172a",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "android": {
      "package": "com.meetriders.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "meetriders",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MeetRiders uses your location to center the map and help you pin pickup/drop-off points."
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "915689d1-92f5-460b-af43-b2401a5accaa"
      }
    },
    "owner": "lohitaksha06"
  }
}
